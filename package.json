{
  "name": "bel-otomatis-app",
  "productName": "Bel Otomatis eNJe",
  "version": "1.0.1",
  "description": "Aplikasi Bel Otomatis Kegiatan Harian & Jadwal Shalat Digital Falak",
  "main": "main/index.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.enje.belotomatis",
    "productName": "Bel Otomatis eNJe",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bel Otomatis eNJe"
    },
    "asar": false
  },
  "keywords": [],
  "author": "Naufal Baidawi",
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^11.0.0"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  }
}
